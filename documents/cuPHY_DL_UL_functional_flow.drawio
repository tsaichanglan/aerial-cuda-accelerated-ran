arent="1" source="Up91" target="Up92"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up96" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="Up92" target="Up93"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up97" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="Up93" target="Up94"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up98" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up19" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up33" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up42" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up49" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up102" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up57" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up103" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up68" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up104" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;dashed=1;strokeColor=#d6b656;" edge="1" parent="1" source="Up79" target="Up91"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="Up105" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;• cuphydriver issues setup()/run() per channel object each slot, batching all cells of the cell group (UL_TTI.request drives what is scheduled).&lt;br&gt;• FFT/CP removal are done in the RU (O-RAN split 7.2x); cuPHY starts from frequency-domain IQ.&lt;br&gt;• Early-HARQ: PUSCH can run a sub-slot path on the first DMRS/data symbols to decode HARQ-ACK before the full slot arrives.&lt;br&gt;• SRS channel estimates are kept in GPU buffers and reused by the DL BFW pipeline." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="270" y="908" width="1300" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>